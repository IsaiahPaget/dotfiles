{
  "position": "top",
  "margin-top": 5,

  "modules-center": [
    "clock",
    "hyprland/workspaces",
    "pulseaudio",
    "network",
	"battery",
    "backlight",
    "tray"
  ],

  "clock": {
    "format": "{:%I:%M %p, %b %d}",
	 "timezone": "Etc/GMT+7", 
    "tooltip": false,
  },

  "pulseaudio": {
    "format": "",
    "format-muted": "󰝟",
    "tooltip": true,
    "tooltip-format": "{volume}%",
    "on-click": "pavucontrol"
  },

  "network": {
    "format-wifi": "",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰖪",
    "tooltip": false,
    "on-click": "networkmanager"
  },

  "backlight": {
    "format": "󰃠",
    "tooltip": true,
    "tooltip-format": "{percent}%"
  },

  "battery": {
    "bat": "BAT0",
    "adapter": "AC",

    "format": "󰁹",
    "format-charging": "󰂄",
    "format-plugged": "󰂄",
    "format-warning": "󰂃",
    "format-critical": "󰁺",

    "tooltip": true,
    "tooltip-format": "{capacity}%",

    "states": {
      "warning": 30,
      "critical": 15
    }
  },

  "tray": {
    "spacing": 8
  },

	"hyprland/workspaces": {
		"format": "{name}",
		"all-outputs": true,
		"show-special": false
	}
}
